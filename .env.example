# ============================================================
# DocuRAG - Environment Configuration Template
# Copy this file to .env and fill in your values
# ============================================================

# --- Application ---
APP_NAME=DocuRAG
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=change-this-to-a-secure-random-secret-key

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_WORKERS=1

# --- PostgreSQL (primary database + pgvector) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=docurag
POSTGRES_USER=docurag_user
POSTGRES_PASSWORD=change-this-password
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
DATABASE_URL=postgresql+asyncpg://docurag_user:change-this-password@localhost:5432/docurag

# --- Redis (task queue & caching) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# --- Storage Paths ---
STORAGE_BASE_DIR=./data
RAW_DOCS_DIR=./data/raw
PROCESSED_DOCS_DIR=./data/processed
TEMP_DIR=./data/temp
LOGS_DIR=./logs

# --- Embedding Model (local, CPU-optimised) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIM=384

# --- LLM (llama.cpp GGUF, CPU inference) ---
LLM_MODEL_PATH=./models/llm/model.gguf
LLM_CONTEXT_SIZE=4096
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1
LLM_N_THREADS=8
LLM_N_GPU_LAYERS=0

# --- OCR ---
OCR_ENGINE=tesseract
TESSERACT_CMD=tesseract
OCR_DPI=300
OCR_CONFIDENCE_THRESHOLD=60

# --- Document Processing ---
MAX_FILE_SIZE_MB=100
SUPPORTED_EXTENSIONS=.pdf,.docx,.xlsx,.csv,.png,.jpg,.jpeg,.tiff,.bmp
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MIN_CHUNK_SIZE=50

# --- Language Detection ---
DEFAULT_LANGUAGE=en
LANGDETECT_MIN_CONFIDENCE=0.8

# --- Celery Task Queue ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_SERIALIZER=json
CELERY_MAX_RETRIES=3

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/docurag.log
LOG_ROTATION=10MB
LOG_RETENTION=7
